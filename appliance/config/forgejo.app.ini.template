APP_NAME = XYvirtual Project Git
RUN_MODE = prod
WORK_PATH = {{FORGEJO_DATA}}

[server]
PROTOCOL = http
HTTP_ADDR = 127.0.0.1
HTTP_PORT = {{FORGEJO_PORT}}
DOMAIN = {{HOSTNAME}}
ROOT_URL = https://{{HOSTNAME}}{{HTTPS_PORT_SUFFIX}}/git/
OFFLINE_MODE = true
; Git is offered only over HTTPS through the entry (/git/). With SSH enabled Forgejo manages
; ~/.ssh/authorized_keys in the service user's home (the state root, not writable for it) and the
; native service died on start (EP-APPLIANCE-001 rehearsal, 2026-11-04).
DISABLE_SSH = true

[database]
DB_TYPE = sqlite3
PATH = {{FORGEJO_DATA}}/forgejo.db

[repository]
ROOT = {{FORGEJO_DATA}}/repositories

[security]
INSTALL_LOCK = true
SECRET_KEY_URI = file:{{FORGEJO_SECRET_FILE}}
INTERNAL_TOKEN_URI = file:{{FORGEJO_INTERNAL_TOKEN_FILE}}

[oauth2]
; Supplied like the other secrets: Forgejo otherwise generates it on first start and saves it into
; this file, which native mode keeps read-only (ProtectSystem=strict) — the service then failed on
; every start (EP-APPLIANCE-001 rehearsal, 2026-11-04).
JWT_SECRET_URI = file:{{FORGEJO_JWT_SECRET_FILE}}

[service]
DISABLE_REGISTRATION = true
REQUIRE_SIGNIN_VIEW = true

[log]
MODE = console
LEVEL = Info
